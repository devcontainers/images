{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/devcontainers/images/blob/main/.github/variant-lifecycle/versions.schema.json",
  "title": "Dev Container image lifecycle data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discussionNumber",
        "url",
        "updatedAt",
        "retrievedAt",
        "commentId",
        "commentUrl"
      ],
      "properties": {
        "discussionNumber": {
          "const": 1464
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/devcontainers/images/discussions/1464$"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "commentId": {
          "type": "string",
          "minLength": 1
        },
        "commentUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/devcontainers/images/discussions/1464#discussioncomment-[^\\s]+$"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "version",
          "status",
          "releaseDate",
          "eolDate",
          "eolEstimated",
          "images",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "eol",
              "unknown"
            ]
          },
          "releaseDate": {
            "$ref": "#/$defs/partialDate"
          },
          "eolDate": {
            "$ref": "#/$defs/partialDate"
          },
          "eolEstimated": {
            "type": "boolean"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "image",
                "variant"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "variant": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "partialDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(-((0[1-9])|(1[0-2]))(-(([0-2][0-9])|(3[0-1])))?)?$"
    }
  }
}
