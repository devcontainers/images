{
  "version": "2.3.0",
  "variants": [
    "1.27-trixie",
    "1.26-trixie",
    "1.27-bookworm",
    "1.26-bookworm"
  ],
  "build": {
    "latest": "1.27-trixie",
    "rootDistro": "debian",
    "tags": [
      "go:${VERSION}-${VARIANT}"
    ],
    "architectures": {
      "1.27-trixie": [
        "linux/amd64",
        "linux/arm64"
      ],
      "1.26-trixie": [
        "linux/amd64",
        "linux/arm64"
      ],
      "1.27-bookworm": [
        "linux/amd64",
        "linux/arm64"
      ],
      "1.26-bookworm": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    "variantTags": {
      "1.27-trixie": [
        "go:${VERSION}-1.27",
        "go:${VERSION}-1",
        "go:${VERSION}-1-trixie",
        "go:${VERSION}-trixie"
      ],
      "1.26-trixie": [
        "go:${VERSION}-1.26"
      ],
      "1.27-bookworm": [
        "go:${VERSION}-1-bookworm",
        "go:${VERSION}-bookworm"
      ],
      "1.26-bookworm": [
        "go:${VERSION}-1-bookworm",
        "go:${VERSION}-bookworm"
      ]
    }
  },
  "dependencies": {
    "image": "golang:${VARIANT}",
    "imageLink": "https://hub.docker.com/_/golang",
    "debian": [
      {
        "cgIgnore": false,
        "name": "yarn"
      },
      "g++",
      "gcc",
      "libc6-dev",
      "make",
      "pkg-config"
    ],
    "git": {
      "Oh My Zsh!": "/home/vscode/.oh-my-zsh",
      "nvm": "/usr/local/share/nvm"
    },
    "go": {
      "golang.org/x/tools/gopls": null,
      "honnef.co/go/tools": null,
      "golang.org/x/lint": null,
      "github.com/mgechev/revive": null,
      "github.com/uudashr/gopkgs": null,
      "github.com/ramya-rao-a/go-outline": null,
      "github.com/go-delve/delve": null,
      "github.com/golangci/golangci-lint": null
    },
    "languages": {
      "Go": {
        "cgIgnore": true
      }
    },
    "other": {
      "git": {}
    }
  }
}